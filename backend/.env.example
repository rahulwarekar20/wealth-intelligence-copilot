DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
# Optional: URL encode special characters in the password (e.g. @ -> %40)
JWT_SECRET=generate_with_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
FINNHUB_API_KEY=get_from_finnhub.io
ALPHA_VANTAGE_API_KEY=get_from_alphavantage.co
GROQ_API_KEY=get_from_console.groq.com
# SEC EDGAR (free, no key) requires "AppName contact-email" as the User-Agent
SEC_USER_AGENT=WealthIntelligenceCopilot your-email@example.com
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Optional: separate database used by the test suite (it is wiped on every test run)
TEST_DATABASE_URL=postgresql+psycopg2://wealth:wealth_dev_password@localhost:5432/wealth_copilot_test
