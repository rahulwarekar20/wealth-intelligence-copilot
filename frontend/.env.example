# Copy to .env.local and adjust.

# URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Phone / tunnel demos: use the built-in proxy instead, so only port 3000 must be reachable
# NEXT_PUBLIC_API_URL=/backend
# BACKEND_URL=http://localhost:8000          # where the proxy forwards to (default shown)
# ALLOWED_DEV_ORIGINS=10.0.0.159             # your computer's Wi-Fi address (see ipconfig)
